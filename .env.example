DB_PASSWORD=changeme
JWT_SECRET=changeme
SCANNER_API_KEY=changeme
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Opcional: URL de webhook entrante (Discord o Slack) para alertas de vulnerabilidades criticas / credenciales por defecto
ALERT_WEBHOOK_URL=
# Opcional: notificaciones por email de los mismos eventos (vulnerabilidades criticas, credenciales por defecto,
# parcheos, bloqueos de cuenta). Se necesitan SMTP_HOST y ALERT_EMAIL_TO como minimo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=proyecto-cyber@localhost
ALERT_EMAIL_TO=
# Clave API de solo lectura para el servidor MCP (servicio "mcp"). Generarla desde el dashboard
# (Integraciones -> Generar clave) DESPUES del primer arranque, y pegarla aqui; reiniciar el
# servicio "mcp" (docker compose up -d --build mcp) para que la recoja.
MCP_API_KEY=
